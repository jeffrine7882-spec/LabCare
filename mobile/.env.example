// LabCare mobile app — the single source of truth for API keys that must stay
// out of version control. Copy this to `.env` and fill in the two grab-bag
// values from your Firebase project (Firebase Console → Project settings →
// Your apps → Expo mobile app).
//
//   FIREBASE_APP_ID=1:123456789:android:abcdef123456
//   FIREBASE_SENDER_ID=123456789

FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
