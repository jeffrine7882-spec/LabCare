{
  "expo": {
    "name": "LabSynch",
    "slug": "labcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "labcare",
    "icon": "./assets/icon.png",
    "splash": { "backgroundColor": "#b91c1c" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.insforge.labcare"
    },
    "android": {
      "package": "com.insforge.labcare",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#b91c1c",
          "icon": "./assets/notif-icon.png",
          "sounds": ["./assets/alert.wav"]
        }
      ]
    ],
    "extra": {
      "apiBase": "https://labcare.insforge.site"
    }
  }
}
