{
  "name": "labcare-desktop",
  "version": "1.0.0",
  "description": "LabCare desktop alerts for Windows — rings for every bell notification from the system tray.",
  "main": "main.js",
  "author": "LabCare",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.insforge.labcare",
    "productName": "LabCare Alerts",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LabCare Alerts",
      "runAfterFinish": true
    }
  }
}
