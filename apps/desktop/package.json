{
  "name": "labcare-desktop",
  "version": "1.4.0",
  "description": "LabSynch desktop alerts for Windows \u2014 rings for every bell notification from the system tray, and opens the LabSynch site.",
  "main": "main.js",
  "author": "LabSynch",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node check-package.js && node smoke-test.js",
    "verify:package": "node check-package.js",
    "pack": "npm test && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.insforge.labcare",
    "productName": "LabSynch Alerts",
    "files": [
      "main.js",
      "preload.js",
      "bubble.html",
      "bubble-preload.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LabSynch Alerts",
      "runAfterFinish": true,
      "include": "build/uninstaller.nsh"
    }
  }
}
