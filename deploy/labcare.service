[Unit]
Description=LabCare — Complaint & Breakdown Management (backend)
After=network.target

[Service]
# ---------------------------------------------------------------------------
# Edit these two lines to where you installed the project on the VPS.
# Recommended: a virtualenv so system Python is untouched.
# ---------------------------------------------------------------------------
WorkingDirectory=/opt/labcare/server
ExecStart=/opt/labcare/venv/bin/python3 run.py
# ---------------------------------------------------------------------------

User=www-data
Group=www-data

# Data lives in /var/lib/labcare so it's easy to back up (create it first:
#   sudo mkdir -p /var/lib/labcare && sudo chown www-data:www-data /var/lib/labcare)
Environment=PORT=8000
Environment=LABCARE_DB=/var/lib/labcare/labcare.db
Environment=LABCARE_HISTORY_LOG=/var/lib/labcare/ticket_history.log
Environment=LABCARE_SECURE_COOKIES=1          # behind HTTPS — keep enabled
# Points QR codes at the public URL users open (Netlify frontend). Edit me:
Environment=LABCARE_PORTAL_URL=https://labcareassist.netlify.app
Environment=PYTHONUNBUFFERED=1

# Restart policy
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
